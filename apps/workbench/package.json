{
  "name": "multi-agent-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-agent workbench for Cursor, Codex, and Doubao",
  "homepage": "https://botdirectory.ai/workbench/",
  "author": {
    "name": "Workbench",
    "email": "workbench@botdirectory.ai"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --publish never",
    "electron:build:linux": "vite build && electron-builder --linux AppImage deb --publish never",
    "electron:build:win": "vite build && electron-builder --win portable --publish never",
    "electron:build:mac": "vite build && electron-builder --mac dmg --publish never",
    "cap:sync": "vite build && npx cap sync",
    "cap:android": "vite build && npx cap sync android && npx cap open android",
    "cap:ios": "vite build && npx cap sync ios && npx cap open ios"
  },
  "build": {
    "appId": "ai.botdirectory.workbench",
    "productName": "多智能体工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "public/icon-512.png",
      "maintainer": "Workbench <workbench@botdirectory.ai>"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon-512.png",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
