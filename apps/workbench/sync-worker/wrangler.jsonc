{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "workbench-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workbench-sync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
